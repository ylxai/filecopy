<Window x:Class="FileCopyUtility.Windows.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Web Gallery Generator" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GlassMainBackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content (Tabs) -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Web Gallery Generator" Style="{StaticResource GlassTitleText}" FontSize="28"/>
            <TextBlock Text="Publish photos directly to Google Drive for client selection" Style="{StaticResource GlassBodyText}" Opacity="0.7"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="0,0,0,0" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,20,0" Padding="10,5">
                                    <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="0,0,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GlassAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource GlassAccentBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#718096"/> <!-- Slate-500 for better contrast on light bg -->
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: New Gallery -->
            <TabItem Header="New Gallery">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Source -->
                            <RowDefinition Height="Auto"/> <!-- Settings -->
                            <RowDefinition Height="Auto"/> <!-- Progress -->
                            <RowDefinition Height="*"/>    <!-- Detailed Logs -->
                            <RowDefinition Height="Auto"/> <!-- Actions -->
                        </Grid.RowDefinitions>

                        <!-- Source Folder -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Source Folder" Style="{StaticResource GlassBodyText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSourceFolder" Style="{StaticResource GlassTextBox}" IsReadOnly="True" Height="40" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse..." Click="BtnBrowse_Click" Style="{StaticResource GlassButton}" Margin="12,0,0,0" Width="100" Height="40"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Settings -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Gallery Settings" Style="{StaticResource GlassTitleText}" FontSize="16" Margin="0,0,0,16"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Google Drive Folder ID (Result)" Style="{StaticResource GlassBodyText}" Opacity="0.7" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TxtResultId" Style="{StaticResource GlassTextBox}" IsReadOnly="True" Height="45" VerticalContentAlignment="Center" FontWeight="Bold" Foreground="{StaticResource GlassAccentBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Web Link -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Right">
                                    <TextBlock Text="View at: " Style="{StaticResource GlassBodyText}" Opacity="0.6" VerticalAlignment="Center"/>
                                    <TextBlock Text="clients.hafiportrait.photography" Foreground="#4F83FF" Cursor="Hand" MouseLeftButtonDown="TxtWebLink_MouseLeftButtonDown" TextDecorations="Underline" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Progress Section -->
                        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Upload Progress" Style="{StaticResource GlassBodyText}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                
                                <Grid>
                                    <ProgressBar x:Name="ProgressBar" Height="10" Background="#33FFFFFF" Foreground="{StaticResource GlassAccentBrush}" BorderThickness="0" Value="0" Maximum="100"/>
                                </Grid>
                                
                                <TextBlock x:Name="TxtProgressStatus" Text="Waiting to start..." Style="{StaticResource GlassBodyText}" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.8" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- Detailed Logs -->
                        <Border Grid.Row="3" Style="{StaticResource GlassCard}" Margin="0,0,0,24" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="Detailed Logs" Style="{StaticResource GlassBodyText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                
                                <!-- Terminal-like container for logs -->
                                <TextBox x:Name="TxtLog" Text="Ready..." Style="{StaticResource GlassTextBox}" VerticalAlignment="Stretch" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#1A000000" Grid.Row="1" Padding="10"/>
                            </Grid>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
                            <Button Content="Close" IsCancel="True" Click="BtnClose_Click" Style="{StaticResource GlassButton}" Background="#33FFFFFF" Margin="0,0,12,0" Width="120" Height="45"/>
                            <Button x:Name="BtnPublish" Content="Publish to Drive" Click="BtnPublish_Click" Style="{StaticResource GlassButton}" Width="180" Height="45" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: History -->
            <TabItem Header="History">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="0">
                        <ListView x:Name="ListHistory" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" CornerRadius="8" Margin="4">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="Bd" Property="Background" Value="#10000000"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="true">
                                                        <Setter TargetName="Bd" Property="Background" Value="#20000000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FolderName}" Style="{StaticResource GlassBodyText}" FontWeight="Bold" FontSize="16" Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding CreatedAt}" Style="{StaticResource GlassBodyText}" FontSize="12" Opacity="0.7" Margin="0,4,0,0" Foreground="#475569"/>
                                            <TextBlock Text="{Binding FolderId}" Style="{StaticResource GlassBodyText}" FontSize="11" Opacity="0.5" FontFamily="Consolas" Margin="0,2,0,0" Foreground="#64748B"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Copy ID" Click="BtnCopyHistoryId_Click" Tag="{Binding FolderId}" Style="{StaticResource GlassButton}" Height="36" Padding="16,0" FontSize="12" Margin="0,0,8,0"/>
                                            <Button Content="Delete" Click="BtnDeleteHistory_Click" Tag="{Binding FolderId}" Style="{StaticResource GlassButton}" Background="#33FF4444" Height="36" Padding="12,0" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Refresh" Click="BtnRefreshHistory_Click" Style="{StaticResource GlassButton}" Width="100" Height="40"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
