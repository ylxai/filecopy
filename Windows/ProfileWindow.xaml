<Window x:Class="FileCopyUtility.Windows.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Manager" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#f0eff2">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#b85493" Padding="20">
            <StackPanel>
                <TextBlock Text="📁 Profile Manager" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Save and manage your copy configurations" FontSize="14" Foreground="#f7f6f8"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Profile List -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Saved Profiles" FontSize="16" FontWeight="SemiBold" Foreground="#6b6570" Margin="0,0,0,8"/>
                <ListBox x:Name="ListProfiles" Height="400" SelectionChanged="ListProfiles_SelectionChanged" Background="White" BorderBrush="#d1c7de">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#6b6570"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="➕ New Profile" 
                       Background="#b85493"
                       BorderBrush="#b85493"
                       Foreground="White"
                       Padding="12,8"
                       FontWeight="Medium"
                       Margin="0,8,0,0"
                       Click="BtnNewProfile_Click"/>
            </StackPanel>

            <!-- Profile Details -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelProfileDetails" Visibility="Collapsed">
                    <TextBlock Text="Profile Details" FontSize="18" FontWeight="SemiBold" Foreground="#6b6570" Margin="0,0,0,16"/>
                    
                    <TextBox x:Name="TxtProfileName" 
                            Text="Profile Name*"
                            Background="White"
                            BorderBrush="#d1c7de"
                            Padding="12,8"
                            FontSize="14"
                            Margin="0,0,0,16"/>
                    
                    <TextBox x:Name="TxtDescription" 
                            Text="Description"
                            Background="White"
                            BorderBrush="#d1c7de"
                            Padding="12,8"
                            FontSize="14"
                            Height="60"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"
                            Margin="0,0,0,16"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <Button Content="💾 Save Profile" 
                               Background="#22c55e"
                               BorderBrush="#22c55e"
                               Foreground="White"
                               Padding="12,8"
                               FontWeight="Medium"
                               Click="BtnSaveProfile_Click"
                               Margin="0,0,8,0"/>
                        <Button Content="🗑️ Delete" 
                               Background="#ef4444"
                               BorderBrush="#ef4444"
                               Foreground="White"
                               Padding="12,8"
                               FontWeight="Medium"
                               Click="BtnDeleteProfile_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="#e8e5f0" 
                BorderBrush="#d1c7de"
                BorderThickness="0,1,0,0" 
                Padding="16">
            <Button Content="Close" 
                   HorizontalAlignment="Right"
                   Background="#6b7280"
                   BorderBrush="#6b7280"
                   Foreground="White"
                   Padding="12,8"
                   FontWeight="Medium"
                   Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>
