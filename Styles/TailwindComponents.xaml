<!--
    Tailwind CSS v4 Component Styles for WPF
    Modern UI components following Tailwind's design principles
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Import Tailwind Colors -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TailwindColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ========================================= -->
    <!-- TAILWIND SPACING VALUES -->
    <!-- ========================================= -->
    
    <!-- Spacing Scale (converted from rem to WPF units) -->
    <Thickness x:Key="Spacing1">4</Thickness>
    <Thickness x:Key="Spacing2">8</Thickness>
    <Thickness x:Key="Spacing3">12</Thickness>
    <Thickness x:Key="Spacing4">16</Thickness>
    <Thickness x:Key="Spacing5">20</Thickness>
    <Thickness x:Key="Spacing6">24</Thickness>
    <Thickness x:Key="Spacing8">32</Thickness>
    <Thickness x:Key="Spacing10">40</Thickness>
    <Thickness x:Key="Spacing12">48</Thickness>
    <Thickness x:Key="Spacing16">64</Thickness>
    <Thickness x:Key="Spacing20">80</Thickness>
    <Thickness x:Key="Spacing24">96</Thickness>

    <!-- Border Radius -->
    <CornerRadius x:Key="RoundedNone">0</CornerRadius>
    <CornerRadius x:Key="RoundedSm">2</CornerRadius>
    <CornerRadius x:Key="Rounded">4</CornerRadius>
    <CornerRadius x:Key="RoundedMd">6</CornerRadius>
    <CornerRadius x:Key="RoundedLg">8</CornerRadius>
    <CornerRadius x:Key="RoundedXl">12</CornerRadius>
    <CornerRadius x:Key="Rounded2Xl">16</CornerRadius>
    <CornerRadius x:Key="Rounded3Xl">24</CornerRadius>
    <CornerRadius x:Key="RoundedFull">9999</CornerRadius>

    <!-- ========================================= -->
    <!-- BUTTON STYLES (Tailwind Design System) -->
    <!-- ========================================= -->

    <!-- Base Button Style -->
    <Style x:Key="TailwindButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RoundedMd}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="contentPresenter"
                                        Focusable="False"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Margin="{TemplateBinding Padding}"
                                        RecognizesAccessKey="True"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Gray300Brush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Gray300Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource Gray500Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button (bg-blue-600 hover:bg-blue-700) -->
    <Style x:Key="TailwindButtonPrimary" TargetType="Button" BasedOn="{StaticResource TailwindButtonBase}">
        <Setter Property="Background" Value="{StaticResource Blue600Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Blue600Brush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Tag" Value="{StaticResource Blue700Brush}" />
    </Style>

    <!-- Secondary Button (bg-gray-200 hover:bg-gray-300) -->
    <Style x:Key="TailwindButtonSecondary" TargetType="Button" BasedOn="{StaticResource TailwindButtonBase}">
        <Setter Property="Background" Value="{StaticResource Gray200Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gray200Brush}" />
        <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
        <Setter Property="Tag" Value="{StaticResource Gray300Brush}" />
    </Style>

    <!-- Success Button (bg-green-600 hover:bg-green-700) -->
    <Style x:Key="TailwindButtonSuccess" TargetType="Button" BasedOn="{StaticResource TailwindButtonBase}">
        <Setter Property="Background" Value="{StaticResource Green600Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Green600Brush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Tag" Value="{StaticResource Green700Brush}" />
    </Style>

    <!-- Danger Button (bg-red-600 hover:bg-red-700) -->
    <Style x:Key="TailwindButtonDanger" TargetType="Button" BasedOn="{StaticResource TailwindButtonBase}">
        <Setter Property="Background" Value="{StaticResource Red600Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Red600Brush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Tag" Value="{StaticResource Red700Brush}" />
    </Style>

    <!-- Warning Button (bg-amber-500 hover:bg-amber-600) -->
    <Style x:Key="TailwindButtonWarning" TargetType="Button" BasedOn="{StaticResource TailwindButtonBase}">
        <Setter Property="Background" Value="{StaticResource Amber500Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Amber500Brush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Tag" Value="{StaticResource Amber600Brush}" />
    </Style>

    <!-- Outline Button (border-gray-300 hover:bg-gray-50) -->
    <Style x:Key="TailwindButtonOutline" TargetType="Button" BasedOn="{StaticResource TailwindButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}" />
        <Setter Property="Foreground" Value="{StaticResource Gray700Brush}" />
        <Setter Property="Tag" Value="{StaticResource Gray50Brush}" />
    </Style>

    <!-- Ghost Button (hover:bg-gray-100) -->
    <Style x:Key="TailwindButtonGhost" TargetType="Button" BasedOn="{StaticResource TailwindButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Gray700Brush}" />
        <Setter Property="Tag" Value="{StaticResource Gray100Brush}" />
    </Style>

    <!-- ========================================= -->
    <!-- TEXTBOX STYLES -->
    <!-- ========================================= -->

    <!-- Base TextBox Style -->
    <Style x:Key="TailwindTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
        <Setter Property="CaretBrush" Value="{StaticResource Blue600Brush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Blue200Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RoundedMd}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"
                                    Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Gray400Brush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Blue600Brush}" />
                            <Setter TargetName="border" Property="Background" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Gray100Brush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Gray200Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource Gray400Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================= -->
    <!-- CARD STYLES -->
    <!-- ========================================= -->

    <!-- Base Card Style (bg-white shadow-md rounded-lg) -->
    <Style x:Key="TailwindCard" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Gray200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RoundedLg}" />
        <Setter Property="Padding" Value="{StaticResource Spacing6}" />
        <Setter Property="Margin" Value="{StaticResource Spacing4}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource Gray900Color}" 
                                Opacity="0.1" 
                                BlurRadius="10" 
                                ShadowDepth="4" 
                                Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large Card with more shadow -->
    <Style x:Key="TailwindCardLarge" TargetType="Border" BasedOn="{StaticResource TailwindCard}">
        <Setter Property="Padding" Value="{StaticResource Spacing8}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource Gray900Color}" 
                                Opacity="0.15" 
                                BlurRadius="20" 
                                ShadowDepth="6" 
                                Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================= -->
    <!-- PROGRESS BAR STYLES -->
    <!-- ========================================= -->

    <!-- Modern Progress Bar -->
    <Style x:Key="TailwindProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource Gray200Brush}" />
        <Setter Property="Foreground" Value="{StaticResource Blue600Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="ProgressBarRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RoundedFull}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track"
                                     Fill="{TemplateBinding Background}" />
                            <Rectangle x:Name="PART_Indicator"
                                     Fill="{TemplateBinding Foreground}"
                                     HorizontalAlignment="Left"
                                     RadiusX="4" 
                                     RadiusY="4" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================= -->
    <!-- LABEL STYLES -->
    <!-- ========================================= -->

    <!-- Base Label -->
    <Style x:Key="TailwindLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Gray700Brush}" />
        <Setter Property="Padding" Value="0,0,0,4" />
    </Style>

    <!-- Heading Styles -->
    <Style x:Key="TailwindH1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="TailwindH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="TailwindH3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="TailwindH4" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Body Text -->
    <Style x:Key="TailwindBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Gray700Brush}" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Small Text -->
    <Style x:Key="TailwindSmallText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Gray600Brush}" />
    </Style>

    <!-- Muted Text -->
    <Style x:Key="TailwindMutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Gray500Brush}" />
    </Style>

    <!-- ========================================= -->
    <!-- ALERT/BADGE STYLES -->
    <!-- ========================================= -->

    <!-- Success Alert -->
    <Style x:Key="TailwindAlertSuccess" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Green50Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Green200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RoundedMd}" />
        <Setter Property="Padding" Value="{StaticResource Spacing4}" />
        <Setter Property="Margin" Value="{StaticResource Spacing2}" />
    </Style>

    <!-- Error Alert -->
    <Style x:Key="TailwindAlertError" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Red50Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Red200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RoundedMd}" />
        <Setter Property="Padding" Value="{StaticResource Spacing4}" />
        <Setter Property="Margin" Value="{StaticResource Spacing2}" />
    </Style>

    <!-- Warning Alert -->
    <Style x:Key="TailwindAlertWarning" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Amber50Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Amber200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RoundedMd}" />
        <Setter Property="Padding" Value="{StaticResource Spacing4}" />
        <Setter Property="Margin" Value="{StaticResource Spacing2}" />
    </Style>

    <!-- Info Alert -->
    <Style x:Key="TailwindAlertInfo" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Blue50Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Blue200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RoundedMd}" />
        <Setter Property="Padding" Value="{StaticResource Spacing4}" />
        <Setter Property="Margin" Value="{StaticResource Spacing2}" />
    </Style>

</ResourceDictionary>