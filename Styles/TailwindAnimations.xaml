<!--
    Tailwind CSS v4 Inspired Animations for WPF
    Modern smooth transitions and micro-interactions
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================= -->
    <!-- ANIMATION DURATIONS (Tailwind-inspired) -->
    <!-- ========================================= -->
    
    <!-- Duration Scale -->
    <Duration x:Key="Duration75">0:0:0.075</Duration>
    <Duration x:Key="Duration100">0:0:0.1</Duration>
    <Duration x:Key="Duration150">0:0:0.15</Duration>
    <Duration x:Key="Duration200">0:0:0.2</Duration>
    <Duration x:Key="Duration300">0:0:0.3</Duration>
    <Duration x:Key="Duration500">0:0:0.5</Duration>
    <Duration x:Key="Duration700">0:0:0.7</Duration>
    <Duration x:Key="Duration1000">0:0:1.0</Duration>

    <!-- ========================================= -->
    <!-- EASING FUNCTIONS (Tailwind-inspired) -->
    <!-- ========================================= -->
    
    <!-- Ease functions matching Tailwind CSS -->
    <CubicEase x:Key="EaseLinear" EasingMode="EaseInOut" />
    <QuadraticEase x:Key="EaseIn" EasingMode="EaseIn" />
    <QuadraticEase x:Key="EaseOut" EasingMode="EaseOut" />
    <QuadraticEase x:Key="EaseInOut" EasingMode="EaseInOut" />
    <CubicEase x:Key="EaseInCubic" EasingMode="EaseIn" />
    <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut" />
    <CubicEase x:Key="EaseInOutCubic" EasingMode="EaseInOut" />
    <BackEase x:Key="EaseInBack" EasingMode="EaseIn" Amplitude="1.7" />
    <BackEase x:Key="EaseOutBack" EasingMode="EaseOut" Amplitude="1.7" />
    <BounceEase x:Key="EaseOutBounce" EasingMode="EaseOut" />
    <ElasticEase x:Key="EaseOutElastic" EasingMode="EaseOut" />

    <!-- ========================================= -->
    <!-- FADE ANIMATIONS -->
    <!-- ========================================= -->

    <!-- Fade In Animation -->
    <Storyboard x:Key="FadeInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="{StaticResource Duration300}"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <!-- Fade Out Animation -->
    <Storyboard x:Key="FadeOutStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0"
                         Duration="{StaticResource Duration200}"
                         EasingFunction="{StaticResource EaseIn}" />
    </Storyboard>

    <!-- ========================================= -->
    <!-- SLIDE ANIMATIONS -->
    <!-- ========================================= -->

    <!-- Slide Down Animation -->
    <Storyboard x:Key="SlideDownStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="-20" To="0"
                         Duration="{StaticResource Duration300}"
                         EasingFunction="{StaticResource EaseOutCubic}" />
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="{StaticResource Duration300}"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <!-- Slide Up Animation -->
    <Storyboard x:Key="SlideUpStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="20" To="0"
                         Duration="{StaticResource Duration300}"
                         EasingFunction="{StaticResource EaseOutCubic}" />
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="{StaticResource Duration300}"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <!-- Slide Left Animation -->
    <Storyboard x:Key="SlideLeftStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="30" To="0"
                         Duration="{StaticResource Duration300}"
                         EasingFunction="{StaticResource EaseOutCubic}" />
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="{StaticResource Duration300}"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <!-- ========================================= -->
    <!-- SCALE ANIMATIONS -->
    <!-- ========================================= -->

    <!-- Scale In Animation -->
    <Storyboard x:Key="ScaleInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.95" To="1.0"
                         Duration="{StaticResource Duration200}"
                         EasingFunction="{StaticResource EaseOutCubic}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.95" To="1.0"
                         Duration="{StaticResource Duration200}"
                         EasingFunction="{StaticResource EaseOutCubic}" />
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="{StaticResource Duration200}"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <!-- Scale Out Animation -->
    <Storyboard x:Key="ScaleOutStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="1.0" To="0.95"
                         Duration="{StaticResource Duration150}"
                         EasingFunction="{StaticResource EaseInCubic}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="1.0" To="0.95"
                         Duration="{StaticResource Duration150}"
                         EasingFunction="{StaticResource EaseInCubic}" />
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0"
                         Duration="{StaticResource Duration150}"
                         EasingFunction="{StaticResource EaseIn}" />
    </Storyboard>

    <!-- ========================================= -->
    <!-- BOUNCE ANIMATIONS -->
    <!-- ========================================= -->

    <!-- Bounce In Animation -->
    <Storyboard x:Key="BounceInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.3" To="1.0"
                         Duration="{StaticResource Duration500}"
                         EasingFunction="{StaticResource EaseOutBounce}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.3" To="1.0"
                         Duration="{StaticResource Duration500}"
                         EasingFunction="{StaticResource EaseOutBounce}" />
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="{StaticResource Duration300}"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <!-- ========================================= -->
    <!-- ROTATION ANIMATIONS -->
    <!-- ========================================= -->

    <!-- Spin Animation -->
    <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         From="0" To="360"
                         Duration="{StaticResource Duration1000}"
                         EasingFunction="{StaticResource EaseLinear}" />
    </Storyboard>

    <!-- Pulse Animation -->
    <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="1.0" To="1.05"
                         Duration="{StaticResource Duration1000}"
                         EasingFunction="{StaticResource EaseInOut}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="1.0" To="1.05"
                         Duration="{StaticResource Duration1000}"
                         EasingFunction="{StaticResource EaseInOut}" />
    </Storyboard>

    <!-- ========================================= -->
    <!-- HOVER ANIMATIONS -->
    <!-- ========================================= -->

    <!-- Hover Scale Animation -->
    <Storyboard x:Key="HoverScaleInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="1.02"
                         Duration="{StaticResource Duration150}"
                         EasingFunction="{StaticResource EaseOut}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="1.02"
                         Duration="{StaticResource Duration150}"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <Storyboard x:Key="HoverScaleOutStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="1.0"
                         Duration="{StaticResource Duration150}"
                         EasingFunction="{StaticResource EaseOut}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="1.0"
                         Duration="{StaticResource Duration150}"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <!-- Hover Lift Animation -->
    <Storyboard x:Key="HoverLiftStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         To="-2"
                         Duration="{StaticResource Duration200}"
                         EasingFunction="{StaticResource EaseOut}" />
        <!-- Shadow effect would be handled separately -->
    </Storyboard>

    <Storyboard x:Key="HoverLiftReverseStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         To="0"
                         Duration="{StaticResource Duration200}"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <!-- ========================================= -->
    <!-- PROGRESS BAR ANIMATIONS -->
    <!-- ========================================= -->

    <!-- Progress Bar Fill Animation -->
    <Storyboard x:Key="ProgressFillStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Width"
                         Duration="{StaticResource Duration300}"
                         EasingFunction="{StaticResource EaseOutCubic}" />
    </Storyboard>

    <!-- ========================================= -->
    <!-- NOTIFICATION ANIMATIONS -->
    <!-- ========================================= -->

    <!-- Slide In From Top -->
    <Storyboard x:Key="NotificationSlideInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="-100" To="0"
                         Duration="{StaticResource Duration300}"
                         EasingFunction="{StaticResource EaseOutBack}" />
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="{StaticResource Duration200}"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <!-- Slide Out To Top -->
    <Storyboard x:Key="NotificationSlideOutStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="0" To="-100"
                         Duration="{StaticResource Duration200}"
                         EasingFunction="{StaticResource EaseInCubic}" />
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0"
                         Duration="{StaticResource Duration200}"
                         EasingFunction="{StaticResource EaseIn}" />
    </Storyboard>

    <!-- ========================================= -->
    <!-- LOADING ANIMATIONS -->
    <!-- ========================================= -->

    <!-- Loading Dots Animation -->
    <Storyboard x:Key="LoadingDotsStoryboard" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:0">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.4" />
            <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0.4" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="LoadingDots2Storyboard" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.4" />
            <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0.4" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="LoadingDots3Storyboard" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.4">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.4" />
            <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0.4" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- ========================================= -->
    <!-- TRANSFORM GROUPS -->
    <!-- ========================================= -->

    <!-- Combined Transform for animations -->
    <Style x:Key="AnimatedElement" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform />
                    <RotateTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>

</ResourceDictionary>